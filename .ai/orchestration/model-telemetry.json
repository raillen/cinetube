{
  "version": 2,
  "tracking": {
    "record_per_llm_call": [
      "provider",
      "model",
      "tier",
      "effort",
      "data_policy_class",
      "agent",
      "task_id",
      "input_tokens",
      "output_tokens",
      "cached_tokens_if_available",
      "observed_or_estimated_cost",
      "fallback_reason",
      "evidence_before",
      "evidence_after",
      "result"
    ],
    "result_values": ["pass", "fail", "partial", "aborted", "unavailable"],
    "cost_source": ["observed-provider", "estimated-provider-rate", "subscription-quota", "free", "contributor-discount"]
  },
  "reporting": {
    "per_task": true,
    "per_goal": true,
    "cumulative": true,
    "compare_tier_distribution_to_target": true,
    "flag_unnecessary_escalation": true,
    "flag_sensitive_restricted_pool_use": true,
    "compare_contributor_savings_to_standard_paid_routes": true
  }
}
