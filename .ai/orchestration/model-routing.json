      "default_tier": "T1",
      "route": ["opencode/deepseek-v4-flash-free", "opencode/mimo-v2.5-free", "meta/muse-spark-1.2-contributor", "command-code/deepseek-v4-flash", "command-code/minimax-m3", "command-code/gpt-5.6-luna", "command-code/glm-5.2"]
    },
    "database-engineer": {
      "default_tier": "T1",
      "route": ["opencode/deepseek-v4-flash-free", "meta/muse-spark-1.2-contributor", "command-code/deepseek-v4-flash", "command-code/gpt-5.6-luna", "command-code/glm-5.2"],
      "critical": ["google/gemini-3.1-pro", "command-code/gpt-5.6-luna"],
