    "T0": ["deterministic-tools"],
    "T1": ["opencode/deepseek-v4-flash-free", "opencode/mimo-v2.5-free", "opencode/big-pickle"],
    "T2": ["meta/muse-spark-1.2-contributor", "command-code/deepseek-v4-flash", "command-code/minimax-m3", "google/gemini-3.7-flash"],
    "T3": ["meta/muse-spark-1.2-contributor", "command-code/gpt-5.6-luna", "command-code/glm-5.2", "google/gemini-3.7-flash"],
    "T4": ["google/gemini-3.1-pro", "command-code/gpt-5.6-luna", "command-code/glm-5.2"],
